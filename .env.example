# ═══════════════════════════════════════════════════════════════════════════════
#  Lab44 Platform — environment reference
#
#  There are two ways to deploy:
#
#    Docker (recommended)  → run ./scripts/install.sh
#                            It generates a .env for you (with real secrets) and
#                            starts docker-composeV2.yml. You do not need to fill
#                            anything in by hand; used only as a reference.
#
#    Bare metal / your own DB → copy this file to .env and fill it in.
#
#  NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ─── Lab44 application secrets ────────────────────────────────────────────────

# Password for the built-in administrator account.
# Store as a bcrypt hash (recommended):
#   node -e "require('bcryptjs').hash('yourpassword', 12).then(console.log)"
ADMIN_PASSWORD="change-me"

# Session signing key. Any length; generate with: openssl rand -hex 32
SESSION_SECRET="generate-with-openssl-rand-hex-32"

# Field-encryption key for stored third-party credentials.
# MUST be exactly 32 bytes of text — `openssl rand -hex 16` gives exactly 32
# characters. (A base64 32-byte value is 44 characters; the app still works by
# hashing it, but hex is the documented format.)
ENCRYPTION_KEY="generate-with-openssl-rand-hex-16"

# ─── Integrations (normally seeded automatically in Docker) ───────────────────
#
# These are stored in the `Setting` table and are editable in the admin UI.
# When the matching environment variables below are present, they are inserted
# automatically on first boot. A value that already exists is NEVER overwritten,
# so anything you change in the UI survives restarts.
#
# Note the internal/public split. The Lab44 SERVER talks to these services over
# the network it can see (Docker service names), while a user's BROWSER needs a
# publicly resolvable address. Set both when they differ.

# XCP-ng hypervisor (optional — configure in the admin UI if you prefer)
XCPNG_HOST=""
XCPNG_USERNAME=""
XCPNG_PASSWORD=""

# Apache Guacamole
GUACAMOLE_INTERNAL_URL="http://guacamole:8080/guacamole"   # server → Guacamole
GUACAMOLE_PUBLIC_URL=""                                    # browser → Guacamole
GUACAMOLE_ADMIN_USERNAME="guacadmin"
GUACAMOLE_ADMIN_PASSWORD=""

# ownCloud
OWNCLOUD_INTERNAL_URL="http://owncloud:8080"               # server → ownCloud OCS API
OWNCLOUD_PUBLIC_URL=""                                     # browser → ownCloud login
OWNCLOUD_ADMIN_USERNAME="admin"
OWNCLOUD_ADMIN_PASSWORD=""

# Allow students to create their own accounts (Setting: signup_enabled)
SIGNUP_ENABLED=false

# Shared secret for the auto-backup endpoint when called from a scheduler:
#   GET /api/admin/backups/check   with header   x-cron-secret: <value>
# Leave empty to require an admin session instead.
CRON_SECRET=""

# ─── TLS / transport hardening ────────────────────────────────────────────────

# XCP-ng XML-RPC runs over HTTPS (port 443) and a default XCP-ng install uses a
# SELF-SIGNED certificate. With verification enabled, every call fails with
# "unable to verify the first certificate" / "self signed certificate".
#
# Only the literal string "false" disables verification; anything else —
# including unset, empty, or a typo — keeps certificate validation ON.
#
#   false → accept the host's certificate unvalidated. Works immediately, but
#           the hypervisor connection is not protected against interception.
#   true  → validate it (pair this with XCP_CA_CERT below).
XCP_REJECT_UNAUTHORIZED=false

# Preferred alternative to disabling verification: trust the host's own
# certificate. The value may be EITHER the PEM contents themselves, OR a path to
# a PEM file (the path form is much easier in Docker, where a multi-line PEM in
# an .env value is awkward).
#
#   docker/  XCP_CA_CERT=/certs/xcpng-ca.pem      (mounted from ./certs)
#   bare metal/ XCP_CA_CERT="/etc/ssl/xcpng-ca.pem"
#
# Obtain it with:
#   openssl s_client -showcerts -connect <xcpng-host>:443 </dev/null 2>/dev/null \
#     | openssl x509 -outform PEM > xcpng-ca.pem
XCP_CA_CERT=""

# Session cookie policy.
#
# In production the session cookie is marked "Secure", which browsers only store
# over HTTPS. They make exactly ONE exception: http://localhost is treated as a
# secure context. A LAN address is not. So with a Secure cookie you get the
# confusing split where http://localhost:3000 works fully, while
# http://192.168.1.50:3000 loads the page but every API call returns
# "Authentication required." because the cookie is silently dropped.
#
#   true  → the cookie is also sent over plain HTTP.
#           Required while the app is reached as http://<lan-ip>:3000.
#   false → the cookie is HTTPS-only (recommended once TLS is in place).
#
# Docker: docker-composeV2.yml defaults this to true, because the stack itself
# serves plain HTTP on its published ports. Set it to false in .env once you
# reach Lab44 through HTTPS.
ALLOW_INSECURE_COOKIES=true

# Set to "true" to skip the automatic settings seeding entirely.
# LAB44_SKIP_SETTINGS_SEED=false
